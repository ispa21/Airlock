{
  "manifest_version": 3,
  "name": "Airlock",
  "version": "0.1.0",
  "description": "Protect sensitive data before you paste it into AI tools. Text is checked on your computer by the Airlock app; nothing is sent anywhere.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "contextMenus", "storage", "clipboardWrite"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": {
    "default_title": "Airlock",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
